{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "bin": "build/src/backend/src/index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node build/src/backend/src/index.js",
    "build:ts": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:mac": "yarn build:ts && yarn build:pkg:mac",
    "build:win": "yarn build:ts && yarn build:pkg:win",
    "build:pkg:mac": "cross-env NODE_ENV=production pkg . --out-dir dist --target node24-macos",
    "build:pkg:win": "cross-env NODE_ENV=production pkg . --out-dir dist --target node24-win",
    "package:mac": "yarn build:mac",
    "package:win": "yarn build:win",
    "prestart": "yarn && yarn clean && yarn build:ts",
    "lint": "eslint . --fix",
    "dev": "cross-env NODE_ENV=development nodemon src/index.ts",
    "preview": "yarn start",
    "clean": "rm -rf dist && rm -rf build",
    "format": "prettier . --write",
    "copy:env": "copyfiles .env.production dist && copyfiles .env.production build/src/backend",
    "copy:bin:mac": "copyfiles -u 1 \".bin/mac/**/*\"  dist/.bin",
    "copy:bin:win": "copyfiles -u 1 \".bin/win/**/*\"  dist/.bin",
    "predev": "yarn",
    "prebuild:ts": "yarn && yarn clean",
    "prebuild:mac": "yarn && yarn clean",
    "prebuild:win": "yarn && yarn clean",
    "postbuild:mac": "yarn copy:env && yarn copy:bin:mac",
    "postbuild:win": "yarn copy:env && yarn copy:bin:win"
  },
  "keywords": [],
  "author": "Ankit Kumar Pandit",
  "license": "ISC",
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.4",
    "fluent-ffmpeg": "2.1.3",
    "jsonwebtoken": "^9.0.3",
    "lodash.uniqby": "4.7.0",
    "mime": "3.0.0",
    "mkdirp": "3.0.1",
    "multer": "2.5.0",
    "node-json-db": "2.6.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/mime": "^3.0.4",
    "@types/multer": "^2.3.0",
    "@yao-pkg/pkg": "^6.25.0",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15"
  }
}
