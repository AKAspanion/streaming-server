{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "outDir": "./build/src",
    "rootDir": "..",
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "types": ["node", "../../global.d.ts"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "sourceMap": false,
    "allowJs": true,
    "esModuleInterop": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@middleware/*": ["./src/middleware/*"],
      "@middleware": ["./src/middleware"],
      "@database/*": ["./src/database/*"],
      "@database": ["./src/database"],
      "@modules/*": ["./src/modules/*"],
      "@modules": ["./src/modules"],
      "@constants/*": ["./src/constants/*"],
      "@constants": ["./src/constants"],
      "@config/*": ["./src/config/*"],
      "@config": ["./src/config"],
      "@services/*": ["./src/services/*"],
      "@services": ["./src/services"],
      "@static/*": ["./src/static/*"],
      "@static": ["./src/static"],
      "@lib/*": ["./src/lib/*"],
      "@lib": ["./src/lib"],
      "@utils/*": ["./src/utils/*"],
      "@utils": ["./src/utils"],
      "@common/*": ["../common/*"],
      "@common": ["../common"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "./build", "./dist"]
}
