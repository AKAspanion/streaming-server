{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"yarn dev\" \"wait-on http://localhost:5709 && yarn start:electron\"",
    "start:electron": "electron .",
    "build:electron": "electron-builder build",
    "prestart:electron": "yarn build",
    "prebuild:electron": "yarn build",
    "build": "tsc && vite build",
    "package:mac": "yarn build",
    "package:win": "yarn build",
    "lint": "eslint src --report-unused-disable-directives",
    "preview": "vite preview",
    "prepreview": "yarn build",
    "clean": "rm -rf dist && rm -rf build",
    "format": "prettier . --write",
    "predev": "yarn",
    "prebuild": "yarn && yarn clean"
  },
  "keywords": [],
  "author": "Ankit Kumar Pandit",
  "license": "ISC",
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@reduxjs/toolkit": "2.14.0",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "hls.js": "1.7.4",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "react-modal": "3.16.3",
    "react-redux": "9.3.1",
    "react-router-dom": "7.18.5",
    "redux-persist": "6.0.0",
    "srt-webvtt": "2.0.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.7"
  }
